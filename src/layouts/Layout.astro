---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../components/Terminal.astro';
import { getProfile } from '../data/content';

interface Props {
	title?: string;
	description?: string;
}

const profile = await getProfile();
const { title, description = profile.data.tagline } = Astro.props;
const fullTitle = title ? `${title} · ${profile.data.name}` : profile.data.name;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0f14" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<!-- Vercel Web Analytics: counts page views. Only works on Vercel; does nothing locally. -->
		<script is:inline defer src="/_vercel/insights/script.js"></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main" class="container">
			<slot />
		</main>
		<Footer />
		<Terminal />
	</body>
</html>

<style>
	main {
		flex: 1;
		padding-block: var(--space-5) var(--space-6);
	}

	.skip-link {
		position: absolute;
		left: var(--space-3);
		top: -100%;
		padding: var(--space-2) var(--space-3);
		background: var(--accent);
		color: var(--bg);
		z-index: 100;
	}

	.skip-link:focus {
		top: var(--space-2);
	}
</style>
