---
import Layout from '../layouts/Layout.astro';
import { getProfile } from '../data/content';

const profile = await getProfile();
const { email, socials } = profile.data;
---

<Layout title="Contact">
	<p class="eyebrow">ping</p>
	<h1>Get in touch</h1>
	<p class="intro">The best way to reach me is by email. I'm also around on the links below.</p>

	<a class="email" href={`mailto:${email}`}>{email}</a>

	{
		socials.length > 0 && (
			<ul class="socials">
				{socials.map((social) => (
					<li>
						<a href={social.url} rel="me">
							<span class="arrow" aria-hidden="true">→</span> {social.label}
						</a>
					</li>
				))}
			</ul>
		)
	}
</Layout>

<style>
	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3rem);
	}

	.intro {
		max-width: 36rem;
		margin: var(--space-3) 0 var(--space-5);
		color: var(--text-muted);
	}

	.email {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: clamp(1.1rem, 4vw, 1.75rem);
		color: var(--accent);
		word-break: break-all;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		margin: var(--space-5) 0 0;
		padding: 0;
		list-style: none;
	}

	.socials a {
		font-family: var(--font-mono);
		color: var(--text);
		text-decoration: none;
	}

	.socials a:hover {
		color: var(--accent);
	}

	.arrow {
		color: var(--accent);
	}
</style>
