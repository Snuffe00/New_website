---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../data/content';
import { categories, formatPeriod, formatTeam, statuses } from '../../data/projects';

// Builds one page per project file, e.g. /projects/example-project.
export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, category, status, start, end, hours, team, role, course, organization, tags, url, repo } =
	project.data;
const { Content } = await render(project);

// Rows for the fact box. Optional fields that aren't filled in are skipped.
const facts = [
	['Category', categories[category].label],
	['Period', formatPeriod(start, end)],
	['Status', statuses[status]],
	['Time spent', hours && `~${hours} hours`],
	['Team', team && formatTeam(team)],
	['My role', role],
	['Course', course],
	['Organization', organization],
].filter((fact): fact is [string, string] => Boolean(fact[1]));
---

<Layout title={title} description={description}>
	<article>
		<a class="back" href="/projects">cd ..</a>
		<p class="eyebrow">cat {project.id}.md</p>
		<h1>{title}</h1>
		<p class="lead">{description}</p>

		<dl class="facts">
			{
				facts.map(([label, value]) => (
					<div>
						<dt>{label}</dt>
						<dd>{value}</dd>
					</div>
				))
			}
		</dl>

		{tags.length > 0 && <ul class="tags">{tags.map((tag) => <li>{tag}</li>)}</ul>}

		{
			(url || repo) && (
				<div class="links">
					{url && <a class="button" href={url}>Visit site ↗</a>}
					{repo && <a class="button ghost" href={repo}>Source code ↗</a>}
				</div>
			)
		}

		<div class="prose">
			<Content />
		</div>
	</article>
</Layout>

<style>
	article {
		max-width: 44rem;
	}

	.back {
		display: inline-block;
		margin-bottom: var(--space-4);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}

	.back::before {
		content: '$ ';
		color: var(--text-muted);
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3rem);
	}

	.lead {
		margin: var(--space-3) 0;
		font-size: 1.2rem;
		color: var(--text-muted);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
		gap: var(--space-3) var(--space-4);
		margin: var(--space-4) 0;
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-elevated);
	}

	dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
	}

	dd {
		margin: 0;
		color: var(--text);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.prose {
		margin-top: var(--space-5);
		padding-top: var(--space-4);
		border-top: 1px solid var(--border);
	}

	.prose :global(h2) {
		margin-top: var(--space-5);
	}

	.prose :global(code) {
		padding: 0.1em 0.35em;
		border-radius: 4px;
		background: var(--bg-elevated);
		color: var(--accent);
	}
</style>
